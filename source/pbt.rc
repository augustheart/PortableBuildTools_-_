#include <windows.h>
#include "dialog.h"

#define CREATEPROCESS_MANIFEST_RESOURCE_ID 1
#define RT_MANIFEST 24

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST
BEGIN
    "<?xml version=""1.0"" encoding=""UTF-8"" standalone=""yes""?>"
    "<assembly xmlns=""urn:schemas-microsoft-com:asm.v1"" manifestVersion=""1.0"">"
    "  <dependency>"
    "    <dependentAssembly>"
    "      <assemblyIdentity"
    "        type=""Win32"""
    "        name=""Microsoft.Windows.Common-Controls"""
    "        version=""6.0.0.0"""
    "        processorArchitecture=""*"""
    "        publicKeyToken=""6595b64144ccf1df"""
    "        language=""*"""
    "      />"
    "    </dependentAssembly>"
    "  </dependency>"
    "  <application xmlns=""urn:schemas-microsoft-com:asm.v3"">"
    "    <windowsSettings>"
    "      <dpiAware xmlns=""http://schemas.microsoft.com/SMI/2005/WindowsSettings"">true/pm</dpiAware>"
    "      <dpiAwareness xmlns=""http://schemas.microsoft.com/SMI/2016/WindowsSettings"">PerMonitorV2</dpiAwareness>"
    "    </windowsSettings>"
    "  </application>"
    "</assembly>"
END

icon ICON "pbt.ico"

ID_DIALOG DIALOGEX 0, 0, 245, 128
STYLE DS_SETFONT | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "PortableBuildTools Setup 2.10.2"
FONT 9, "Segoe UI", 0, 0, 0x1
BEGIN
	COMBOBOX	ID_COMBO_ENV,	5,	5,	160,	0, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
	CONTROL "Preview channel",	ID_CHECK_PREVIEW, "Button", BS_AUTOCHECKBOX | WS_TABSTOP | WS_CHILD | WS_VISIBLE,	175,	5,	70,	12
	LTEXT "MSVC Version",	-1,	5,	25,	100,	12
	COMBOBOX	ID_COMBO_MSVC,	5,	35,	55,	0, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
	LTEXT "SDK Version",	-1,	65,	25,	100,	12
	COMBOBOX	ID_COMBO_SDK,	65,	35,	55,	0, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
	LTEXT "Host Arch",	-1,	125,	25,	100,	12
	COMBOBOX	ID_COMBO_HOST,	125,	35,	55,	0, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
	LTEXT "Target Arch",	-1,	185,	25,	100,	12
	COMBOBOX	ID_COMBO_TARGET,	185,	35,	55,	0, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
	CONTROL	"ATL+MFC", ID_CHECK_ATL,"Button", BS_AUTOCHECKBOX | WS_TABSTOP | WS_CHILD | WS_VISIBLE, 6, 52, 60, 14
    	CONTROL	 "Spectre", ID_CHECK_SPECTRE,"Button", BS_AUTOCHECKBOX | WS_TABSTOP | WS_CHILD | WS_VISIBLE,71, 52, 60, 14
	GROUPBOX "Destination Folder",	-1, 5, 73, 235, 3
	EDITTEXT	ID_EDIT_PATH,	10, 83, 165, 14, ES_AUTOHSCROLL | WS_TABSTOP
	PUSHBUTTON "Browse...",	ID_BUTTON_BROWSE,	180, 83, 55, 14
	CONTROL "",	ID_CHECK_LICENSE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP | WS_CHILD | WS_VISIBLE,	5, 108, 8, 12
	CONTROL "I accept the <a>License Agreement</a>",	ID_SYSLINK_LICENSE, "SysLink", WS_TABSTOP | WS_CHILD | WS_VISIBLE,	15, 110, 110, 12
	PUSHBUTTON "Install",	ID_BUTTON_INSTALL,	190, 107, 50, 14
END
